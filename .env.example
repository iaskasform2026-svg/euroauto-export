# Copiez ce fichier vers .env et renseignez uniquement ce qui est nécessaire.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="changez-moi-en-production-32-caracteres-min"

# Identité plateforme (affichée aux clients à la place du vendeur)
PLATFORM_NAME="EuropAuto Export [DÉMO]"
PLATFORM_EMAIL="contact@europauto-export.demo"
PLATFORM_PHONE="+33 1 00 00 00 00"
PLATFORM_ADDRESS="Adresse de démonstration — non opérationnelle"
PLATFORM_COUNTRY="FR"

# Rôle commercial : INTERMEDIAIRE | MANDATAIRE | REVENDEUR
# Les contrats et paiements réels restent désactivés tant que CONTRACTS_ENABLED=false
PLATFORM_COMMERCIAL_ROLE="INTERMEDIAIRE"
CONTRACTS_ENABLED="false"
DEFAULT_CURRENCY="EUR"

# Stripe — mode test uniquement tant que CONTRACTS_ENABLED=false
# Ne confirmez jamais un paiement sans événement Stripe vérifié.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP optionnel. Sans SMTP, aucun e-mail n'est marqué comme envoyé.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EuropAuto Export <noreply@localhost>"
